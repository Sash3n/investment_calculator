rules_version = '2';

// FinCalc ZA — Firestore security rules
//
// All app data lives under users/{userId}/... and is strictly scoped to the
// authenticated owner. Nothing is publicly readable or writable.
//
// Deploy with: npx firebase deploy --only firestore:rules
// (or paste into Firebase console > Firestore > Rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // A user may only touch documents under their own uid.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
